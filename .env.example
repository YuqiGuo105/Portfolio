# Public client configuration. No real keys are included here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
WRITER_API_URL=
NEXT_PUBLIC_WRITER_API_URL=
AGENT_SERVICE_URL=
AGENT_SERVICE_INTERNAL_TOKEN=
MCP_SERVER_URL=
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_TOKEN=

# Optional bot scoring. Without it, the configured heuristic remains in use.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_ALLOWED_HOSTS=yuqi.site,www.yuqi.site

# Optional tile source for the visitor globe's close-ups ({z}, {x}, {y} placeholders). Leave empty for NASA GIBS.
MAP_TILE_UPSTREAM=

# Referral requests on /talk (docs/REFERRAL_REQUESTS.md). AI screening stays off unless
# REFERRAL_AI_ENABLED=1 and a Gemini key is present; every call reserves from the shared monthly AI ledger.
REFERRAL_AI_ENABLED=
REFERRAL_GOOGLE_API_KEY=
# The company named on the referral form is the current employer in the work history
# (/admin/experience). These two are for exceptions only: pin another company, or close the form.
REFERRAL_COMPANY=
REFERRALS_PAUSED=
# The chat's waiting line (docs/CHAT_WAITING_LINE.md). All optional; these are the defaults.
CHAT_PLACES=
CHAT_PLACE_SECONDS=
CHAT_PLACE_MESSAGES=
CHAT_DAILY_MESSAGES=
# Shared by the scheduled jobs under /api/cron, including the referral worker.
CRON_SECRET=
