        },
        {
          "id": "outbox",
          "kind": "database",
          "resource": {
            "node": "agent-projectors",
            "title": "Run Audit"
          },
          "title": "Run Outbox",
          "meta": "POSTGRESQL",
          "brand": "postgresql"
        }
      ],
      "steps": [
        {
          "from": "visitor",
          "to": "gateway",
          "label": "POST /api/agent/chat",
          "detail": "opens an SSE stream"
        },
        {
          "self": "gateway",
          "label": "verify JWT session",
          "detail": "anonymous allowed · identity injected"
        },
        {
          "from": "gateway",
          "to": "agent",
          "label": "stream(query, identity)"
        },
        {
          "from": "agent",
          "to": "redis",
          "label": "reserve daily budget",
          "detail": "atomic Lua script"
        },
        {
          "fragment": "break",
          "guard": "daily budget exhausted",
          "steps": [
            {
              "from": "agent",
              "to": "gateway",
              "label": "budget notice · run ends",
              "reply": true
            }
          ]
        },
        {
          "from": "agent",
          "to": "redis",
          "label": "load recent turns",
          "detail": "30-min sliding TTL"
        },
        {
          "from": "agent",
          "to": "gemini",
          "label": "input safety check",
          "detail": "gemini-2.5-flash-lite"
        },
        {
          "fragment": "break",
          "guard": "unsafe input",
          "steps": [
            {
              "from": "agent",
              "to": "gateway",
              "label": "safe refusal",
              "reply": true
            }
          ]
        },
        {
          "from": "agent",
          "to": "gemini",
          "label": "plan route (intent)",
          "detail": "structured output"
        },
        {
          "from": "agent",
          "to": "knowledge",
          "label": "search(query, top 6)",
          "detail": "internal token · 10 s timeout"
        },
        {
          "from": "knowledge",
          "to": "gemini",
          "label": "embed(query)",
          "detail": "gemini-embedding-001 · 1536-d"
