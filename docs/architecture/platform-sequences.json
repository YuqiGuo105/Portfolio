              "guard": "otherwise",
              "steps": [
                {
                  "from": "agent",
                  "to": "gemini",
                  "label": "stream",
                  "detail": "gemini-2.5-flash · 60 s timeout"
                }
              ]
            }
          ]
        },
        {
          "fragment": "loop",
          "guard": "each chunk",
          "steps": [
            {
