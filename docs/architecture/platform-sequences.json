                  "label": "match_current_knowledge_v2",
                  "detail": "cosine · min similarity 0.35"
                },
                {
                  "self": "knowledge",
                  "label": "keep active, public evidence"
                },
                {
                  "from": "knowledge",
                  "to": "agent",
